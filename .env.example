# =====================================================================
# Profit Analytics System - environment configuration
#
# Copy this file to ".env" (same directory) and fill in real values.
# NEVER commit the real ".env" file to version control.
#
# On cPanel: create this file OUTSIDE the public webroot (e.g. one
# level above "public/", in the project root) so it can never be
# downloaded through the browser. See SETUP.md for details.
# =====================================================================

# ---- Application ----------------------------------------------------
APP_NAME="Profit Analytics"
APP_ENV=production
# production | development
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Europe/Budapest

# Base currency used for all aggregated / cross-currency reporting.
APP_BASE_CURRENCY=EUR

# Random 32+ char string, used to derive session / CSRF secrets.
# Generate e.g. with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change_me_to_a_random_64_char_hex_string

# ---- Database (MySQL / MariaDB) -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=profit_analytics
DB_USERNAME=profit_analytics_user
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4

# ---- Session ----------------------------------------------------------
SESSION_LIFETIME_MINUTES=120
SESSION_NAME=profit_analytics_session
# Set to true when served over HTTPS (should always be true in production).
SESSION_SECURE_COOKIE=true

# ---- UNAS API ---------------------------------------------------------
# See: https://unas.hu/tudastar/api  (API key is generated in the UNAS admin)
UNAS_API_KEY=
UNAS_API_BASE_URL=https://api.unas.eu/shop
# Requests per minute the UnasApiService should self-throttle to.
UNAS_RATE_LIMIT_PER_MINUTE=60

# ---- Turum B2B supplier API ---------------------------------------------
# Phase 1 diagnostic only (scripts/test_turum_connection.php) - no
# product/order sync uses this yet. Base URL and auth flow per Turum's
# OpenAPI spec: POST /v1/account/login with {username, password},
# response has access_token/token_type, token documented as valid 24h.
TURUM_API_BASE_URL=https://api.b2b.turum.pl
TURUM_USERNAME=
TURUM_PASSWORD=
# Requests per minute for ordinary Turum endpoints (login, account/me,
# reservations). /v1/products_full_list_new has its own hardcoded
# 1-request-per-minute throttle in TurumApiService - that limit is a
# documented hard API rule, not configurable here.
TURUM_RATE_LIMIT_PER_MINUTE=30

# ---- DPD Polska (shipping labels) -------------------------------------
# DPD Polska web services (DPDServices SOAP API) - generates waybill
# numbers and A4 PDF shipping labels for UNAS orders.
# Needs the PHP SOAP extension (ext-soap) enabled on the server.
# Credentials are issued by DPD Polska (login / haslo / masterFID).
#
# DPD_ENV: "production" -> dpdservices.dpd.com.pl
#          "sandbox"    -> dpdservicesdemo.dpd.com.pl (separate DPD-issued
#                          demo credentials, NOT the production ones).
DPD_ENV=production
DPD_LOGIN=
DPD_PASSWORD=
DPD_MASTER_FID=
# Which sender FID appears on the waybill. DPD may assign several
# (e.g. "fidy DPDServices: 458231,458233"); put the one you ship under.
DPD_SENDER_FID=
# Optional explicit WSDL override; leave blank to use the DPD_ENV default.
DPD_WSDL_URL=
# Label page format: A4 (laser printer) or LBL_PRINTER (10x15 thermal).
DPD_LABEL_PAGE_FORMAT=A4
# Fallback parcel weight (kg) when an order carries no weight of its own.
DPD_DEFAULT_PARCEL_WEIGHT_KG=1.0
# Cash-on-delivery: COD is requested only when the UNAS payment method name
# contains one of these (comma-separated, case-insensitive). Leave blank to
# never request COD. Verify DPD PL COD currency handling with a --dry-run
# before the first live COD shipment.
DPD_COD_PAYMENT_METHODS=
DPD_COD_CURRENCY=PLN
# Requests-per-minute self-throttle for DPD SOAP calls.
DPD_RATE_LIMIT_PER_MINUTE=30
#
# Sender address printed on every DPD label:
DPD_SENDER_COMPANY=
DPD_SENDER_NAME=
DPD_SENDER_ADDRESS=
DPD_SENDER_CITY=
DPD_SENDER_POSTAL_CODE=
DPD_SENDER_COUNTRY_CODE=PL
DPD_SENDER_PHONE=
DPD_SENDER_EMAIL=

# ---- Meta (Facebook/Instagram) Ads API - reserved for a later phase --
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---- Google Ads API - reserved for a later phase ----------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ---- Logging ------------------------------------------------------------
LOG_LEVEL=info
# debug | info | warning | error
